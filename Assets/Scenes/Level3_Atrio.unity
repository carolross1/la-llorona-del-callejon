  m_EditorClassIdentifier: Assembly-CSharp::TutorialTrigger
  tutorialMessage: "\xA1El Atrio de la Parroquia de Dolores!\nLas puertas del templo est\xE1n selladas por el luto de La Llorona.\n\u2022 Encuentra veladoras y usa [F] en los 3 nichos sagrados para romper el sello.\n\u2022 Cada nicho encendido crea una zona segura divina.\n\u2022 Pulsa [E] para esconderte en bancas y confesionarios."
  displayDuration: 4
  triggerOnce: 1
  showOnStart: 1
