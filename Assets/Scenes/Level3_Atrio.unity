  m_Script: {fileID: 11500000, guid: f297e8cde987298458ae324f5c83485f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialTrigger
  tutorialMessage: "\xA1El Atrio de la Parroquia de Dolores!\nLas puertas del templo est\xE1n selladas por el luto espectral.\n\u2022 Busca las 3 columnas de luz divina en el atrio (Oeste, Centro, Este).\n\u2022 Ac\xE9rcate y pulsa [F] con una veladora para consagrar cada Nicho Sagrado.\n\u2022 Si te quedas sin veladoras, acude a la Mesa Bendita en la entrada para reponer.\n\u2022 Pulsa [E] para esconderte de La Llorona en bancas y confesionarios."
  displayDuration: 4
  triggerOnce: 1
  showOnStart: 1
