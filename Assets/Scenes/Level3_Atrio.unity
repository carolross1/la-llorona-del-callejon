  m_Script: {fileID: 11500000, guid: f297e8cde987298458ae324f5c83485f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialTrigger
  tutorialMessage: "\xA1El Atrio de la Parroquia de Dolores!\nLas puertas del templo est\xE1n selladas por el luto espectral.\n\u2022 Hay 4 Nichos Sagrados en el atrio: Claustro de Arcadas (Oeste), Fuente Sagrada (Centro), Gran Mausoleo (Este) y Altar Mayor (Norte).\n\u2022 Ac\xE9rcate a cada nicho con una veladora y pulsa [F] para consagrarlo.\n\u2022 \xA1Cuidado con los escombros de ruinas en el suelo, crujir\xE1n y alertar\xE1n a La Llorona!\n\u2022 Rep\xF3n veladoras en la Mesa Bendita de la entrada siempre que lo necesites.\n\u2022 Pulsa [E] para esconderte en confesionarios, criptas y bancas.\n\u2022 Consagra los 4 nichos sagrados para abrir las puertas y escapar."
  displayDuration: 4
  triggerOnce: 1
  showOnStart: 1
